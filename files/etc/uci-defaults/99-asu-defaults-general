#!/bin/sh
#===============================================================================
# 99-cf-wa350-rescue-wifi — لأغراض التشخيص فقط (لا يُدرج في الـ PR!)
#
# يفعّل الوايفاي بشبكة مفتوحة اسمها WA350-RESCUE حتى لو ماتت الشبكة السلكية
# بالكامل — الوايفاي مستقل عن السويتش/DSA، فإذا أقلع النظام سنصل إليه لاسلكياً
# ونقرأ dmesg ونعرف بالضبط أين فشلت وصلة SGMII، بل ونعيد الترقية عبر الهواء.
#
# مكانه في شجرة البناء (للصورة التجريبية فقط):
#   target/linux/ath79/base-files/etc/uci-defaults/99-cf-wa350-rescue-wifi
#
# بعد انتهاء التشخيص: احذف هذا الملف من الشجرة قبل بناء صورة الـ PR.
#===============================================================================

[ "$(board_name)" = "comfast,cf-wa350" ] || exit 0

uci -q batch <<EOF
set wireless.radio0.disabled='0'
set wireless.radio1.disabled='0'
set wireless.@wifi-iface[0].ssid='WA350-RESCUE-5G'
set wireless.@wifi-iface[0].encryption='none'
set wireless.@wifi-iface[1].ssid='WA350-RESCUE'
set wireless.@wifi-iface[1].encryption='none'
set network.lan.proto='static'
set network.lan.ipaddr='192.168.1.1'
set network.lan.netmask='255.255.255.0'
EOF
uci -q commit wireless
uci -q commit network

logger -t rescue-wifi "WA350 rescue WiFi enabled (diagnostic build)"
exit 0
